[Unit]
Description=VeloPredict App
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/velopredict
Environment=WEATHER_API_KEY=
ExecStart=/opt/velopredict/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
